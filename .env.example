# OpenAI coding engine. Use the Codex-optimized model by default, or override it.
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-5.2-codex

# Public origin used for OAuth callback URLs.
PUBLIC_URL=http://localhost:5173

# Optional GitHub OAuth App settings. Token-based GitHub login works without these.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback

# Required for `npm run publish:vercel` and the GitHub Actions workflow.
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_or_team_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Optional local publish mode. Defaults to production when omitted.
VERCEL_PROD=true
